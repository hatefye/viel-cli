{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "viel",
  "version": "0.4.0",
  "identifier": "tv.viel.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "viel",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
